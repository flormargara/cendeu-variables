{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListarBucketCendeu",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:ListBucketMultipartUploads",
        "s3:GetEncryptionConfiguration",
        "s3:GetBucketPublicAccessBlock"
      ],
      "Resource": "arn:aws:s3:::data-cendeu-raw"
    },
    {
      "Sid": "LeerEscribirObjetosCendeu",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::data-cendeu-raw/*"
    },
    {
      "Sid": "NoBorrarFueraDeCendeu",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:DeleteBucket"
      ],
      "NotResource": ["arn:aws:s3:::data-cendeu-raw/*"]
    }
  ]
}
